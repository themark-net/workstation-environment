#cloud-config
hostname: ${hostname}
fqdn: ${fqdn}
manage_etc_hosts: true
users:
  - name: ${lab_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}
package_update: true
packages:
  - qemu-guest-agent
  - python3
  - python3-pip
  - curl
  - jq
  - ca-certificates
runcmd:
  - systemctl enable --now qemu-guest-agent
  - echo "ltz_role=${role}" > /etc/ltz-lab-role
final_message: "LTZ lab cloud-init done role=${role}"
